# Copy to .env and fill in. Never commit .env.

# Comma-separated bearer tokens accepted by the server.
# Leave empty for local dev (auth disabled) — never deploy publicly with empty.
API_KEYS=

# Transport: "streamable-http" (default) or "stdio" for local Claude Desktop wiring
MCP_TRANSPORT=streamable-http

HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
